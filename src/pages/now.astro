---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allProjects = await getCollection('projects');
const projectsBySlug = new Map(allProjects.map((project) => [project.id, project]));
const currentlyBuildingSlugs = [
  'watchlamp',
  'ai-blueprint',
  'sheetbug',
  'multiprompter',
  'trav-fleet',
  'trav-focus',
];
const currentlyBuilding = currentlyBuildingSlugs
  .map((slug) => projectsBySlug.get(slug))
  .filter((project) => project !== undefined);

const focusNotes: Record<string, string> = {
  watchlamp:
    'accounts, first checks, and the ping worker are implemented. next: the alarm evaluator. no public launch yet.',
  'ai-blueprint':
    'using the workflow in real builds and trimming steps that add more overhead than value.',
  sheetbug:
    'live sign-up sheets, with the organizer dashboard redesigned and smaller image thumbnails.',
  multiprompter:
    'version 1.4 adds code sheets. checking how the released workflow holds up during recording.',
  'trav-fleet':
    'the private, read-only view of machines, ai sessions, installed tool versions, and scheduled jobs.',
  'trav-focus':
    'the private dashboard for daily priorities, todos, calendar, and project notes.',
};

const lastUpdated = '2026-11-11';
---

<BaseLayout
  title="now | brad traversy"
  description="what i'm actively working on right now."
  pageTitle="now.md"
  currentSection="now"
>
  <section class="section">
    <h1 class="h1"><span class="hash"># </span>now</h1>
    <p class="lede">
      what i'm focused on right this minute. updated when the focus shifts.
      see the date at the bottom for the last revision.
    </p>
  </section>

  <section class="section">
    <h2 class="h2"><span class="hash">## </span>right now</h2>
    <p>
      i'm building <a href="/projects/watchlamp" class="link">watchlamp</a>,
      starting with cron checks. accounts, creating a check, and recording pings
      are implemented. the next piece is deciding when a missing ping means
      trouble. alerts and the broader monitoring features are still ahead.
      it isn't publicly launched.
    </p>
    <p>
      i'm using <a href="/projects/ai-blueprint" class="link">ai blueprint</a>
      on real projects and simplifying the workflow as i go. the useful test
      is whether it helps me understand and verify what got built.
    </p>
    <p>
      <a href="/projects/sheetbug" class="link">sheetbug</a> is live, with a
      redesigned organizer dashboard. <a href="/projects/multiprompter"
      class="link">multiprompter</a> 1.4 has shipped code sheets, and i'm
      checking the recording workflow through actual use.
    </p>
    <p>
      my private dashboards now have separate jobs:
      <a href="/projects/trav-focus" class="link">trav focus</a> handles daily
      work, while <a href="/projects/trav-fleet" class="link">trav fleet</a>
      shows machines, sessions, versions, and automations. mission control
      is retired. <a href="/tools/agent-context-monitor" class="link">agent
      context monitor</a> has replaced ctxscope in my setup.
    </p>
  </section>

  <section class="section">
    <h2 class="h2"><span class="hash">## </span>currently building</h2>
    <div class="comment">
      // featured + active projects, with the current push on each
    </div>
    <div class="now-projects">
      {currentlyBuilding.map((project) => (
        <a class="now-project" href={`/projects/${project.id}`}>
          <div class="now-project-head">
            <span class="now-project-name">{project.data.name}</span>
            <span class:list={['pill', project.data.status]}>{project.data.status}</span>
          </div>
          <p class="now-project-note">
            {focusNotes[project.id] ?? project.data.tagline}
          </p>
        </a>
      ))}
    </div>
    <a href="/projects" class="link more-link">→ all projects</a>
  </section>

  <section class="section">
    <h2 class="h2"><span class="hash">## </span>what i'm thinking about</h2>
    <ul class="prose-list">
      <li>detecting quiet failures, including scheduled jobs that stop calling home</li>
      <li>keeping ai workflows understandable as the tooling grows</li>
      <li>showing unknown or stale monitoring data honestly</li>
      <li>judging tools by repeated use after the release checks pass</li>
    </ul>
  </section>

  <section class="section">
    <p class="comment-prose">
      // last updated <strong>{lastUpdated}</strong>. inspired by{' '}
      <a href="https://nownownow.com/about" class="link">/now pages</a>.
    </p>
  </section>

  <div class="comment" style="margin-top: 24px;">
    // EOF now.md<span class="cursor"></span>
  </div>
</BaseLayout>

<style>
  .now-projects {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 12px;
  }
  .now-project {
    display: block;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-2);
    text-decoration: none;
    color: var(--fg-1);
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .now-project:hover {
    border-color: var(--border-strong);
    background: var(--bg-3, var(--bg-2));
  }
  .now-project-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .now-project-name {
    font-weight: 600;
    font-size: 14px;
  }
  .now-project-note {
    margin: 6px 0 0;
    color: var(--fg-muted);
    font-size: 13px;
    line-height: 1.5;
  }
  .prose-list {
    margin: 12px 0 16px;
    padding-left: 20px;
    list-style: disc;
    color: var(--fg-1);
  }
  .prose-list li {
    margin-bottom: 8px;
    line-height: 1.55;
  }
  .comment-prose {
    color: var(--fg-comment);
    font-size: 12.5px;
  }
</style>
