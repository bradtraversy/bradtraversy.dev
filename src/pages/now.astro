---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allProjects = await getCollection('projects');
const projectsBySlug = new Map(allProjects.map((project) => [project.id, project]));
const currentlyBuildingSlugs = [
  'skillpass',
  'devstash',
  'ai-blueprint',
  'mission-control',
  'bradtraversy-dev',
  'vidpipe',
];
const currentlyBuilding = currentlyBuildingSlugs
  .map((slug) => projectsBySlug.get(slug))
  .filter((project) => project !== undefined);

// Manual focus notes per project (1-line "what's the active push here").
// Update these when the focus shifts; if a project isn't listed, the card
// still renders with its tagline as fallback.
const focusNotes: Record<string, string> = {
  skillpass:
    'the busiest lane right now. install from any github repo, a passport badge for readmes, and a prompt tab so an agent can install a skill itself.',
  devstash:
    'public collections: share a curated set of snippets and links by link. owner controls are in, the public page is next.',
  'ai-blueprint':
    'past 1.10 and mostly steady. independent review when a change is sensitive, contributor prs coming in, dark mode.',
  'mission-control':
    'the private ops surface, now deployed on the homelab hub and wired to the new agent cluster.',
  'bradtraversy-dev':
    'the public trail for what shipped. this week it lost 587 bot commits and gained a build-time github page.',
  vidpipe:
    'maintenance month: owner model preferences and article fidelity fixes. publishing destinations are still the next real feature.',
};

const lastUpdated = '2026-09-29';
---

<BaseLayout
  title="now | brad traversy"
  description="what i'm actively working on right now."
  pageTitle="now.md"
  currentSection="now"
>
  <section class="section">
    <h1 class="h1"><span class="hash"># </span>now</h1>
    <p class="lede">
      what i'm focused on right this minute. updated when the focus shifts.
      see the date at the bottom for the last revision.
    </p>
  </section>

  <section class="section">
    <h2 class="h2"><span class="hash">## </span>right now</h2>
    <p>
      main focus: the agent fleet moved onto its own hardware. an old poweredge
      now runs a control vm with paperclip and three dev vms carrying claude,
      codex, and pi, and the first remote-execution gate passed this week. i
      wrote it up in <a href="/devlog/2026-09-28-agent-cluster-on-the-poweredge" class="link">an agent cluster on the old poweredge</a>.
      the near-term work is giving it real projects and deciding what persists
      between runs.
    </p>
    <p>
      on the product side, <a href="/projects/skillpass" class="link">skillpass</a>
      is getting the most commits: 0.5.0 installs skills from any github repo,
      and this week added a readme passport badge and a prompt tab so an agent
      can install a skill itself.
    </p>
    <p>
      <a href="/projects/devstash" class="link">devstash</a> is getting public
      collections, so a curated set of snippets and links can be shared by
      link. and this site lost 587 bot commits and now builds its github page
      at deploy time instead of committing a snapshot every six hours.
    </p>
    <p>
      crossdraft, the private one-markdown-article-to-many-platforms cli, now
      reaches linkedin and facebook pages on top of dev and hashnode. still not
      released, still useful.
    </p>
  </section>

  <section class="section">
    <h2 class="h2"><span class="hash">## </span>currently building</h2>
    <div class="comment">
      // featured + active projects, with the current push on each
    </div>
    <div class="now-projects">
      {currentlyBuilding.map((project) => (
        <a class="now-project" href={`/projects/${project.id}`}>
          <div class="now-project-head">
            <span class="now-project-name">{project.data.name}</span>
            <span class:list={['pill', project.data.status]}>{project.data.status}</span>
          </div>
          <p class="now-project-note">
            {focusNotes[project.id] ?? project.data.tagline}
          </p>
        </a>
      ))}
    </div>
    <a href="/projects" class="link more-link">→ all projects</a>
  </section>

  <section class="section">
    <h2 class="h2"><span class="hash">## </span>what i'm thinking about</h2>
    <ul class="prose-list">
      <li>
        how much to let the agent cluster run unattended. the gates are enforced
        by the runner now; the open question is which projects are boring
        enough to hand over first
      </li>
      <li>
        whether a git history that is 80 percent bot commits is a smell or just
        noise. i decided smell, and rewrote it
      </li>
      <li>
        personal tools as unfair advantages. linesmith, typesmith, crossdraft,
        multiprompter, and the agent workflow are all small things that make
        recording and building less annoying
      </li>
      <li>
        whether vidpipe is a product problem or a distribution problem. the
        crawlable-site work fixed the technical floor; publishing destinations
        are still the feature that would answer it
      </li>
    </ul>
  </section>

  <section class="section">
    <h2 class="h2"><span class="hash">## </span>what i'm not doing</h2>
    <ul class="prose-list">
      <li>no live coding sessions or live streams right now</li>
      <li>not chasing every shiny model release. only swap when there's a real reason</li>
      <li>not building a course platform. that's not what this site is for</li>
      <li>no new sponsor commitments beyond existing ones</li>
    </ul>
  </section>

  <section class="section">
    <p class="comment-prose">
      // last updated <strong>{lastUpdated}</strong>. inspired by{' '}
      <a href="https://nownownow.com/about" class="link">/now pages</a>.
    </p>
  </section>

  <div class="comment" style="margin-top: 24px;">
    // EOF now.md<span class="cursor"></span>
  </div>
</BaseLayout>

<style>
  .now-projects {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 12px;
  }
  .now-project {
    display: block;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-2);
    text-decoration: none;
    color: var(--fg-1);
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .now-project:hover {
    border-color: var(--border-strong);
    background: var(--bg-3, var(--bg-2));
  }
  .now-project-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .now-project-name {
    font-weight: 600;
    font-size: 14px;
  }
  .now-project-note {
    margin: 6px 0 0;
    color: var(--fg-muted);
    font-size: 13px;
    line-height: 1.5;
  }
  .prose-list {
    margin: 12px 0 16px;
    padding-left: 20px;
    list-style: disc;
    color: var(--fg-1);
  }
  .prose-list li {
    margin-bottom: 8px;
    line-height: 1.55;
  }
  .comment-prose {
    color: var(--fg-comment);
    font-size: 12.5px;
  }
</style>
