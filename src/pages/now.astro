---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allProjects = await getCollection('projects');
const projectsBySlug = new Map(allProjects.map((project) => [project.id, project]));
const currentlyBuildingSlugs = [
  'skillpass',
  'devstash',
  'ai-blueprint',
  'mission-control',
  'bradtraversy-dev',
  'vidpipe',
];
const currentlyBuilding = currentlyBuildingSlugs
  .map((slug) => projectsBySlug.get(slug))
  .filter((project) => project !== undefined);

// Manual focus notes per project (1-line "what's the active push here").
// Update these when the focus shifts; if a project isn't listed, the card
// still renders with its tagline as fallback.
const focusNotes: Record<string, string> = {
  skillpass:
    'making skills easier to find and install. agent-specific install guides and the official makers page are live.',
  devstash:
    'public collections, individual snippet sharing, and markdown export are live. next: better sharing previews and saving shared items to your stash.',
  'ai-blueprint':
    'using structured feature workflows and review gates in real projects, then checking where the workflow needs to improve.',
  'mission-control':
    'the private work and lab dashboard, hosted on trav-hub. the poweredge agent cluster is retired.',
  'bradtraversy-dev':
    'keeping project pages and devlogs aligned with what actually shipped, including this now page.',
  vidpipe:
    'maintaining the saas and mcp paths, with recent work on shared model preferences and keeping coding articles faithful to the source.',
};

const lastUpdated = '2026-10-02';
---

<BaseLayout
  title="now | brad traversy"
  description="what i'm actively working on right now."
  pageTitle="now.md"
  currentSection="now"
>
  <section class="section">
    <h1 class="h1"><span class="hash"># </span>now</h1>
    <p class="lede">
      what i'm focused on right this minute. updated when the focus shifts.
      see the date at the bottom for the last revision.
    </p>
  </section>

  <section class="section">
    <h2 class="h2"><span class="hash">## </span>right now</h2>
    <p>
      i'm building ai-assisted workflows and using them on real projects.
      the poweredge agent cluster was an experiment, not the setup i'm running
      now. i've retired it. trav-hub is the central hub for my homelab services,
      including <a href="/projects/mission-control" class="link">mission control</a>.
      paperclip runs separately on trav-ai for scheduled work and agent tickets.
    </p>
    <p>
      agentflow is where i'm working on controlled agent execution. its runner
      handles one approved feature and stops for human acceptance. the first
      live pilot exposed a validator permissions problem, which is fixed;
      a fresh end-to-end run is still needed. automatic repair and working
      through a whole project are goals, not things i'm claiming work today.
    </p>
    <p>
      on the product side, <a href="/projects/skillpass" class="link">skillpass</a>
      now has install guides for each supported agent and an official makers
      page. the focus is making it easier to find a useful skill and understand
      where it comes from before installing it.
    </p>
    <p>
      <a href="/projects/devstash" class="link">devstash</a> has shipped public
      collections and individual snippet links, along with markdown export.
      it's still the project from my coding with ai course, and i'm continuing
      to develop it beyond the course. better sharing previews are next.
    </p>
    <p>
      crossdraft now has a browser workspace for writing an article and
      reviewing versions for different platforms. the new ui prepares drafts;
      it doesn't publish them yet. url import and connecting that review step
      to delivery are the next pieces. it's still in development, not launched.
    </p>
  </section>

  <section class="section">
    <h2 class="h2"><span class="hash">## </span>currently building</h2>
    <div class="comment">
      // featured + active projects, with the current push on each
    </div>
    <div class="now-projects">
      {currentlyBuilding.map((project) => (
        <a class="now-project" href={`/projects/${project.id}`}>
          <div class="now-project-head">
            <span class="now-project-name">{project.data.name}</span>
            <span class:list={['pill', project.data.status]}>{project.data.status}</span>
          </div>
          <p class="now-project-note">
            {focusNotes[project.id] ?? project.data.tagline}
          </p>
        </a>
      ))}
    </div>
    <a href="/projects" class="link more-link">→ all projects</a>
  </section>

  <section class="section">
    <h2 class="h2"><span class="hash">## </span>what i'm thinking about</h2>
    <ul class="prose-list">
      <li>
        how to let agents finish more work without silently skipping validation.
        bounded repair attempts come before automatic project-wide execution
      </li>
      <li>
        checking the result, not just whether a service is running. apimocker's
        health endpoint was green while its daily data reset wasn't happening
      </li>
      <li>
        tools that remove repeated work. multiprompter is live; crossdraft is
        still becoming a product. i want to keep that distinction clear
      </li>
      <li>
        making shared snippets useful outside the app they came from, without
        making private material public by accident
      </li>
    </ul>
  </section>

  <section class="section">
    <h2 class="h2"><span class="hash">## </span>what i'm not doing</h2>
    <ul class="prose-list">
      <li>not running agents on the poweredge or continuing the old factory setup</li>
      <li>not treating agentflow as a fully autonomous project builder yet</li>
      <li>not presenting prototypes or planned features as launched products</li>
    </ul>
  </section>

  <section class="section">
    <p class="comment-prose">
      // last updated <strong>{lastUpdated}</strong>. inspired by{' '}
      <a href="https://nownownow.com/about" class="link">/now pages</a>.
    </p>
  </section>

  <div class="comment" style="margin-top: 24px;">
    // EOF now.md<span class="cursor"></span>
  </div>
</BaseLayout>

<style>
  .now-projects {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 12px;
  }
  .now-project {
    display: block;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-2);
    text-decoration: none;
    color: var(--fg-1);
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .now-project:hover {
    border-color: var(--border-strong);
    background: var(--bg-3, var(--bg-2));
  }
  .now-project-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .now-project-name {
    font-weight: 600;
    font-size: 14px;
  }
  .now-project-note {
    margin: 6px 0 0;
    color: var(--fg-muted);
    font-size: 13px;
    line-height: 1.5;
  }
  .prose-list {
    margin: 12px 0 16px;
    padding-left: 20px;
    list-style: disc;
    color: var(--fg-1);
  }
  .prose-list li {
    margin-bottom: 8px;
    line-height: 1.55;
  }
  .comment-prose {
    color: var(--fg-comment);
    font-size: 12.5px;
  }
</style>
